# Copy this file to .env and fill the values from Firebase console → Project settings.
# Leave the values empty to run fully on this device (IndexedDB), with no cloud account.
# Firestore is used only after these keys exist AND you sign in with Google.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
